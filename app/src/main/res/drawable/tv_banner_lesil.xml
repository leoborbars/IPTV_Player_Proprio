<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="0"
                android:startColor="#10283D"
                android:centerColor="#091522"
                android:endColor="#040910" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#2EA9FF" />
        </shape>
    </item>
    <item
        android:width="82dp"
        android:height="82dp"
        android:drawable="@drawable/lesil_icon"
        android:gravity="center" />
</layer-list>
